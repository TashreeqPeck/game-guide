{
	"name": "game-guide",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "vitest",
		"db:reset": "tsx scripts/db-reset.ts",
		"seed:dev": "tsx scripts/seed-dev.ts",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/github": "^12.0.11",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/better-sqlite3": "^9.6.0",
		"@vitest/coverage-v8": "^5.1.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"husky": "^9.1.7",
		"semantic-release": "^25.0.9",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^6.0.5",
		"better-sqlite3": "^13.2.0",
		"drizzle-orm": "^0.45.4",
		"isomorphic-dompurify": "^3.19.0",
		"marked": "^18.2.1",
		"openid-client": "^6.9.1",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
